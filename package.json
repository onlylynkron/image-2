{
  "name": "image2-studio",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently \"npm run server:dev\" \"npm run client:dev\"",
    "server:dev": "python -m uvicorn server.main:app --host 0.0.0.0 --port 8787 --reload",
    "client:dev": "vite --host 0.0.0.0",
    "build": "npm run build:client",
    "build:client": "tsc -p client/tsconfig.json && vite build",
    "start": "python -m uvicorn server.main:app --host 0.0.0.0 --port 8787",
    "typecheck": "npm run build:client"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^5.0.0",
    "concurrently": "^9.2.1",
    "lucide-react": "^0.468.0",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "vite": "^7.1.12"
  },
  "devDependencies": {
    "@types/react": "^19.1.8",
    "@types/react-dom": "^19.1.6",
    "typescript": "^5.9.2"
  }
}
